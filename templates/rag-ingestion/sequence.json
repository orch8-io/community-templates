{
  "$schema": "https://orch8.io/contracts/sequence.schema.json",
  "schema_version": 1,
  "namespace": "default",
  "name": "rag-ingestion",
  "blocks": [
    {
      "type": "for_each",
      "id": "ingest_documents",
      "collection": "context.data.documents",
      "item_var": "doc",
      "max_iterations": 500,
      "retain_iterations": 20,
      "body": [
        {
          "type": "step",
          "id": "fetch_document",
          "handler": "http_request",
          "params": {
            "method": "GET",
            "url": "{{context.data.doc.url}}",
            "timeout_ms": 30000
          },
          "retry": {
            "max_attempts": 4,
            "initial_backoff": 2000,
            "max_backoff": 60000,
            "backoff_multiplier": 2.0
          }
        },
        {
          "type": "step",
          "id": "embed_document",
          "handler": "embed",
          "params": {
            "input": "{{outputs.fetch_document.body}}",
            "model": "text-embedding-3-small",
            "api_key_env": "OPENAI_API_KEY"
          },
          "retry": {
            "max_attempts": 4,
            "initial_backoff": 2000,
            "max_backoff": 60000,
            "backoff_multiplier": 2.0
          }
        },
        {
          "type": "step",
          "id": "store_document",
          "handler": "memory_store",
          "params": {
            "scope": "tenant",
            "namespace": "{{context.data.memory_namespace}}",
            "key": "{{context.data.doc.id}}",
            "text": "{{outputs.fetch_document.body}}",
            "embedding": "{{outputs.embed_document.embedding}}",
            "model": "text-embedding-3-small",
            "metadata": {
              "source_url": "{{context.data.doc.url}}",
              "title": "{{context.data.doc.title}}"
            }
          }
        }
      ]
    },
    {
      "type": "step",
      "id": "log_done",
      "handler": "log",
      "params": { "message": "rag ingestion finished" }
    }
  ]
}
